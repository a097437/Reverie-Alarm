<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 桌面小工具：今天的班（大字、班別色）＋下一個鬧鐘 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="11dp"
    android:paddingEnd="13dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sm_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="11/23 週一"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sm_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#A855F7"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="夜班"
        android:textColor="#D8B4FE"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sm_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="19:00 – 07:00"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <!-- 撐開中間空白（只能用 RemoteViews 支援的元件） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/sm_alarm_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="下一個鬧鐘 · 今天"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/sm_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="17:40"
        android:textColor="#F1F5F9"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
